# Event MarketPlace settings. On your own computer you need none of these: everything runs locally.
# For the live site, Umit puts them into Vercel → Settings → Environment Variables himself
# (see docs/deployment.md). Never commit real values.

# The site's address, exactly as people type it.
APP_URL=https://marketplace.media10.co.uk

# Neon's pooled connection string (the host contains "-pooler"), ending ?sslmode=require
DATABASE_URL=
# Neon's direct connection string, used only to run migrations during a deploy.
DATABASE_URL_UNPOOLED=

# 32 random bytes, base64: openssl rand -base64 32   (keep a copy in the password manager)
APP_ENCRYPTION_KEY=

# A long random value: openssl rand -hex 32   (Vercel sends it with each scheduled job)
CRON_SECRET=

# Email through Resend, from one verified domain. Each show only sets its sender name.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=marketplace@mail.media10.co.uk

# Files in Cloudflare R2
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=event-marketplace-files
# "eu" if the bucket was created with the EU jurisdiction
R2_JURISDICTION=eu

# Stripe: TEST keys only until the pilot. Leave empty until phase 1.
# A Stripe key without both webhook secrets stops the site starting (on purpose).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Only when creating the first super admin with `npm run bootstrap`
# BOOTSTRAP_SUPER_ADMIN_EMAIL=you@media10.co.uk
